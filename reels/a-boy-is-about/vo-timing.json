 "lines": [
  {
   "id": "hook-1",
   "text": "This is Milo. In about three seconds, a brick is going to land on his head.",
   "start": 0.374,
   "end": 7.024
  },
  {
   "id": "where-1",
   "text": "Where did it come from? Nobody knows. Clouds don't usually do that.",
   "start": 8.74,
   "end": 14.06
  },
  {
   "id": "dread-1",
   "text": "Anyone else would be in serious trouble. But Milo has a secret.",
   "start": 14.981,
   "end": 19.951
  },
  {
   "id": "bonk-1",
   "text": "Milo is made of rubber.",
   "start": 20.82,
   "end": 22.74
  },
  {
   "id": "boing-1",
   "text": "Fully. Head to toe.",
   "start": 24.47,
   "end": 26.36
  },
  {
   "id": "ricochet-1",
   "text": "Which makes the rest of his day... a little bouncy.",
   "start": 27.83,
   "end": 32.18
  },
  {
   "id": "catch-1",
   "text": "But he never drops the ice cream.",
   "start": 34.882,
   "end": 37.572
  },
  {
   "id": "twist-1",
   "text": "Then the sky got greedy.",
   "start": 38.262,
   "end": 40.182
  },
  {
   "id": "twist-2",
   "text": "Milo didn't mind.",
   "start": 40.742,
   "end": 41.892
  },
  {
   "id": "end-1",
   "text": "Be like Milo. Bounce back.",
   "start": 44.263,
   "end": 46.533
  }
 ]
